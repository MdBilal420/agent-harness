# Provider: ollama | bedrock | anthropic | openrouter
# If unset: openrouter when OPENROUTER_API_KEY is set, bedrock when AWS
# IAM/bearer env is set, otherwise ollama.
LLM_PROVIDER=ollama

# --- Local Ollama (Anthropic-compatible) ---
ANTHROPIC_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=ollama
ANTHROPIC_MODEL=qwen3.5:9b

# --- OpenRouter (Anthropic Messages API skin; free models supported) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_MODEL=openrouter/free
# Optional: pin a specific free model, e.g. meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo
# OPENROUTER_APP_TITLE=agent-harness

# --- Amazon Bedrock via IAM (recommended; avoids CallWithBearerToken SCP) ---
# 1. IAM policy: bedrock:InvokeModel, InvokeModelWithResponseStream, ListFoundationModels
# 2. Attach to an IAM user, create access key, then either `aws configure` or set:
# LLM_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...          # only for temporary creds
# # or: AWS_PROFILE=default
# AWS_REGION=ap-southeast-2
# AWS_DEFAULT_REGION=ap-southeast-2
# Use an inference-profile id (global./apac./us.), not a bare anthropic.* id:
# ANTHROPIC_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock API keys (AWS_BEARER_TOKEN_BEDROCK) only if your org allows
# bedrock:CallWithBearerToken — many SCPs deny this.

# --- Anthropic cloud ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

TAVILY_API_KEY=BBBBB
VOYAGE_API_KEY=CCCCC
