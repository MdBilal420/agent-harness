# Local Ollama (Anthropic-compatible). api_key is required by the SDK but ignored.
ANTHROPIC_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=ollama
ANTHROPIC_MODEL=qwen3:latest

# Or Anthropic cloud: leave BASE_URL unset and set a real API key.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

TAVILY_API_KEY=BBBBB
VOYAGE_API_KEY=CCCCC